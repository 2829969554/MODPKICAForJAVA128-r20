connections {
    ikev2-mschapv2 {
        version = 2
        pools = vpnpool
        proposals = aes256-sha256-modp2048,aes128-sha256-modp2048,default
        local {
            auth = pubkey
            certs = 6df2ffa4da321818d0fbdb947328e40e.crt
            id = vpn.local
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            ikev2-mschapv2 {
                remote_ts = 0.0.0.0/0
            }
        }
    }
    ikev2-eaptls {
        version = 2
        pools = vpnpool
        proposals = aes256-sha256-modp2048,aes128-sha256-modp2048,default
        local {
            auth = pubkey
            certs = 6df2ffa4da321818d0fbdb947328e40e.crt
            id = vpn.local
        }
        remote {
            auth = eap-tls
            eap_id = %any
            cacerts = 6cfbd3ad26f760570e04dd10a8f42822.crt
        }
        children {
            ikev2-eaptls {
                remote_ts = 0.0.0.0/0
            }
        }
    }
    ikev1-xauth {
        version = 1
        pools = vpnpool
        proposals = aes256-sha1-modp1024,aes128-sha1-modp1024
        local {
            auth = psk
        }
        remote {
            auth = psk
        }
        remote2 {
            auth = xauth-radius
        }
        children {
            ikev1-xauth {
                esp_proposals = aes256-sha1,aes128-sha1
                remote_ts = 0.0.0.0/0
            }
        }
    }
}

pools {
    vpnpool {
        addrs = 10.10.0.0/24
        dns = 192.168.1.1
    }
}

secrets {
    ike-1 {
        id-remote = cisco-group
        secret = group123456
    }
}
